<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Sistema de Ordenes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .navbar-brand { font-weight: bold; }
        .card { margin-bottom: 1rem; }
        .order-id { max-width: 170px; overflow-wrap: anywhere; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/dashboard">Sistema de Ordenes</a>
            <div class="navbar-nav ms-auto">
                <span class="navbar-text me-3">
                    Bienvenido, <%= user.email %> (<%= user.role %>)
                </span>
                <form method="POST" action="/logout" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Cerrar Sesion</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5>Crear Nueva Orden</h5>
                    </div>
                    <div class="card-body">
                        <form method="POST" action="/orders">
                            <div class="mb-3">
                                <label for="customer" class="form-label">Cliente</label>
                                <input type="text" class="form-control" id="customer" name="customer"
                                       value="<%= user.email %>" required>
                            </div>
                            <div class="mb-3">
                                <label for="sku" class="form-label">SKU</label>
                                <input type="text" class="form-control" id="sku" name="sku" required>
                            </div>
                            <div class="mb-3">
                                <label for="quantity" class="form-label">Cantidad</label>
                                <input type="number" class="form-control" id="quantity" name="quantity"
                                       min="1" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Crear Orden</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5><%= ordersScope === 'all' ? 'Todas las Ordenes' : 'Mis Ordenes' %></h5>
                        <small class="text-muted">
                            <%= ordersScope === 'all' ? 'Vista administrativa' : 'Solo pedidos creados por ti' %>
                        </small>
                    </div>
                    <div class="card-body">
                        <% if (orders.length > 0) { %>
                            <div class="list-group list-group-flush">
                                <% orders.slice(0, 5).forEach(order => { %>
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between gap-2">
                                            <small class="order-id">Orden: <%= order.order_id %></small>
                                            <small><%= order.status %></small>
                                        </div>
                                        <div>
                                            <small>Cliente: <%= order.customer %></small>
                                        </div>
                                        <% if (order.items && order.items.length > 0) { %>
                                            <small>
                                                Items:
                                                <%= order.items.map(item => `${item.sku} x${item.qty}`).join(', ') %>
                                            </small>
                                        <% } %>
                                        <% if (ordersScope === 'all' && order.created_by_email) { %>
                                            <br>
                                            <small class="text-muted">Creada por <%= order.created_by_email %></small>
                                        <% } %>
                                        <br>
                                        <small class="text-muted">
                                            <%= new Date(order.created_at).toLocaleString() %>
                                        </small>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-muted">No hay ordenes recientes</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5>Inventario Disponible</h5>
                    </div>
                    <div class="card-body">
                        <% if (inventory.length > 0) { %>
                            <div class="list-group list-group-flush">
                                <% inventory.slice(0, 5).forEach(item => { %>
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between">
                                            <small>SKU: <%= item.sku || item.product_id || item.id %></small>
                                            <small>Stock: <%= item.stock || item.quantity %></small>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-muted">No hay inventario disponible</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
