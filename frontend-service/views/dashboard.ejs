<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Sistema de Órdenes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .navbar-brand { font-weight: bold; }
        .card { margin-bottom: 1rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="/dashboard">Sistema de Órdenes</a>
            <div class="navbar-nav ms-auto">
                <span class="navbar-text me-3">
                    Bienvenido, <%= user.email %> (<%= user.role %>)
                </span>
                <form method="POST" action="/logout" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Cerrar Sesión</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <!-- Mensajes -->
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row">
            <!-- Crear Orden -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5>Crear Nueva Orden</h5>
                    </div>
                    <div class="card-body">
                        <form method="POST" action="/orders">
                            <div class="mb-3">
                                <label for="product_id" class="form-label">ID del Producto</label>
                                <input type="number" class="form-control" id="product_id" name="product_id"
                                       min="1" required>
                            </div>
                            <div class="mb-3">
                                <label for="quantity" class="form-label">Cantidad</label>
                                <input type="number" class="form-control" id="quantity" name="quantity"
                                       min="1" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Crear Orden</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Órdenes Recientes -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5>Órdenes Recientes</h5>
                    </div>
                    <div class="card-body">
                        <% if (orders.length > 0) { %>
                            <div class="list-group list-group-flush">
                                <% orders.slice(0, 5).forEach(order => { %>
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between">
                                            <small>Producto: <%= order.product_id %></small>
                                            <small>Cant: <%= order.quantity %></small>
                                        </div>
                                        <small class="text-muted">
                                            <%= new Date(order.created_at).toLocaleString() %>
                                        </small>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-muted">No hay órdenes recientes</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Inventario -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5>Inventario Disponible</h5>
                    </div>
                    <div class="card-body">
                        <% if (inventory.length > 0) { %>
                            <div class="list-group list-group-flush">
                                <% inventory.slice(0, 5).forEach(item => { %>
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between">
                                            <small>ID: <%= item.id %></small>
                                            <small>Stock: <%= item.quantity %></small>
                                        </div>
                                        <small class="text-muted">Producto <%= item.product_id %></small>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="text-muted">No hay inventario disponible</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>